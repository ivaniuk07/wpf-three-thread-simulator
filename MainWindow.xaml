<Window x:Class="Lab4_Task1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторна робота 4 — Завдання 1"
        Height="660" Width="930" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Робота трьох потоків" FontSize="25" FontWeight="Bold" Foreground="#172B4D"/>
            <TextBlock Text="У кожен момент один потік працює, а два інші чекають на передачу ходу."
                       Margin="0,5,0,0" FontSize="13" Foreground="#52627A"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Початковий час для всіх (мс):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="IntervalBox" Text="700" Width="72" Padding="5" Margin="0,0,14,0"/>
                <CheckBox x:Name="RandomCheck" Content="Випадковий час при передачі" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button x:Name="StartButton" Content="Старт" Padding="15,7" Margin="0,0,7,0" Click="StartButton_Click" Background="#2563EB" Foreground="White" BorderThickness="0"/>
                <Button x:Name="StopButton" Content="Зупинити" Padding="12,7" Margin="0,0,7,0" Click="StopButton_Click" IsEnabled="False"/>
                <Button x:Name="ResetButton" Content="Скинути" Padding="12,7" Click="ResetButton_Click"/>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,2,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="9" Margin="0,0,7,0" Padding="12">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Потік 1" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#172B4D"/>
                    <Border x:Name="StateBorder1" Grid.Row="1" Background="#E8EDF5" CornerRadius="3" Margin="0,6,0,0" Padding="6,5"><TextBlock x:Name="State1" Text="Готовий" HorizontalAlignment="Stretch" TextAlignment="Center" Foreground="#52627A" FontWeight="SemiBold"/></Border>
                    <Border Grid.Row="2" Background="#E8EDF5" CornerRadius="5" Margin="22,10" ClipToBounds="True"><ScrollViewer x:Name="Scroll1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent"><StackPanel x:Name="Bar1"/></ScrollViewer></Border>
                    <TextBlock x:Name="Stats1" Grid.Row="3" Text="Робота: 0 мс · Очікування: 0 мс" TextAlignment="Center" FontSize="11" Foreground="#52627A"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="9" Margin="3,0" Padding="12">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Потік 2" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#172B4D"/>
                    <Border x:Name="StateBorder2" Grid.Row="1" Background="#E8EDF5" CornerRadius="3" Margin="0,6,0,0" Padding="6,5"><TextBlock x:Name="State2" Text="Готовий" HorizontalAlignment="Stretch" TextAlignment="Center" Foreground="#52627A" FontWeight="SemiBold"/></Border>
                    <Border Grid.Row="2" Background="#E8EDF5" CornerRadius="5" Margin="22,10" ClipToBounds="True"><ScrollViewer x:Name="Scroll2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent"><StackPanel x:Name="Bar2"/></ScrollViewer></Border>
                    <TextBlock x:Name="Stats2" Grid.Row="3" Text="Робота: 0 мс · Очікування: 0 мс" TextAlignment="Center" FontSize="11" Foreground="#52627A"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="9" Margin="7,0,0,0" Padding="12">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Потік 3" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#172B4D"/>
                    <Border x:Name="StateBorder3" Grid.Row="1" Background="#E8EDF5" CornerRadius="3" Margin="0,6,0,0" Padding="6,5"><TextBlock x:Name="State3" Text="Готовий" HorizontalAlignment="Stretch" TextAlignment="Center" Foreground="#52627A" FontWeight="SemiBold"/></Border>
                    <Border Grid.Row="2" Background="#E8EDF5" CornerRadius="5" Margin="22,10" ClipToBounds="True"><ScrollViewer x:Name="Scroll3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent"><StackPanel x:Name="Bar3"/></ScrollViewer></Border>
                    <TextBlock x:Name="Stats3" Grid.Row="3" Text="Робота: 0 мс · Очікування: 0 мс" TextAlignment="Center" FontSize="11" Foreground="#52627A"/>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
            <Rectangle Width="14" Height="14" Fill="#2020F0" RadiusX="3" RadiusY="3" Margin="0,0,6,0"/><TextBlock Text="робота" Margin="0,0,18,0" VerticalAlignment="Center"/>
            <Rectangle Width="14" Height="14" Fill="#F02020" RadiusX="3" RadiusY="3" Margin="0,0,6,0"/><TextBlock Text="очікування" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="SummaryText" Grid.Row="4"
                   Text="Початкова тривалість у всіх потоків однакова. Натисни «Старт», потім «Зупинити», щоб побачити підсумок."
                   TextAlignment="Center" TextWrapping="Wrap" Foreground="#52627A" Margin="0,2,0,0"/>
    </Grid>
</Window>
